FROM ghcr.io/huggingface/chat-ui-db:0.9.4

# Switch to root to modify files, then back to user 1000
USER root

# Optional: Install debugging tools
RUN apt-get update && apt-get install -y --no-install-recommends jq curl && \
    rm -rf /var/lib/apt/lists/*

# Switch back to the non-root user that the base image uses
USER 1000

# Copy your patched build over the original
COPY --chown=1000:1000 build/ /app/build/

# The base image already has the correct ENTRYPOINT and CMD
